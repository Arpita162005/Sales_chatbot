# Copy to .env and edit. Every value is optional - these are the defaults.

# ---- Server
HOST=127.0.0.1
PORT=8000

# ---- Data
DATA_CSV=data/Amazon_Sale_Report_1.csv
DUCKDB_PATH=storage/sales.duckdb
INDEX_DIR=storage/index

# ---- LLM via Ollama: Qwen3 8B Q4_K_M (~5.2 GB)  ->  ollama pull qwen3:8b-q4_K_M
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b-q4_K_M
# 8192 uses ~6.5 GB VRAM in total; 16384 still fits a 12 GB RTX 5070.
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.3
LLM_SQL_TEMPERATURE=0.05
LLM_MAX_TOKENS=900
# Qwen3 thinking mode: better reasoning, 3-10x slower answers.
LLM_THINK=false
LLM_KEEP_ALIVE=30m
LLM_TIMEOUT_S=180

# ---- Embeddings: auto | sentence-transformers | ollama
EMBED_BACKEND=auto
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_EMBED_MODEL=all-minilm
# auto | cpu | cuda
EMBED_DEVICE=auto
TOP_K_DOCS=4
TOP_K_EXAMPLES=4

# ---- Query router
ROUTER_LLM_FALLBACK=true
ROUTER_MIN_CONFIDENCE=0.55

# ---- SQL safety and result sizes
SQL_MAX_ROWS=500
SQL_TIMEOUT_S=15
SQL_RETRIES=2
ROWS_TO_LLM=40
ROWS_TO_UI=100
ENABLE_SQL_CONSOLE=true

# ---- Conversation memory (messages sent back as context)
HISTORY_TURNS=6
